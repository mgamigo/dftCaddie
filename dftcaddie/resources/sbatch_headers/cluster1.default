#SBATCH --nodes=1
#SBATCH --ntasks=40
#SBATCH --mem=88gb
#SBATCH --time=48:00:00
#SBATCH --job-name="NONAME"

export NPROCS=$SLURM_NTASKS
NPOOLS=`python3 -c "print($NPROCS / 4)"`
export NPOOLS

node=$(hostname)
echo "******************"
echo "job run at node " $node
echo "NPROCS = " $NPROCS
echo "NPOOLS = " $NPOOLS
echo "******************"
echo ""
