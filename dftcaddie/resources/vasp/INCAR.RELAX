SYSTEM = NONAME
PREC = Accurate          # precision
ENCUT = 500              # Energy cutoff
EDIFF = 1.0e-07          # global break condition por the scf
ISMEAR = 0; SIGMA = 0.02 # gaussian smearing with its spread
LSORBIT = FALSE          # whether spin orbit is taken into account

IBRION = 2               # Geometry optimization algorithm (conjugate gradient)
POTIM = 0.3              # Relaxation step (0.5 is default)
# EDIFFG = 1.0e-06         # Change of total energy that defines stops relaxation (default is 10xEDIFF)
ISIF = 2                 # (2) Relax ions (3) Also relax cell (there are more options)
#PSTRESS = 0             # Target pressure of the relaxation (if variable cell) in kB.
NSW = 400                # Maximum number of ionic steps
NELM = 300               # Maximum number of electronic steps
ISYM = 1                 # (0) Switch off symmetries (only TRS), (-1) No sym at all, (1) Default sym treatment

ISTART = 0               # from scratch
ICHARG = 2               # Take superposition of atomic charge densities
NPAR = 8                 # number of bands treated in parallel (default=number of cores)

LORBIT = 11              # the way to write PROCAR and DOSCAR
